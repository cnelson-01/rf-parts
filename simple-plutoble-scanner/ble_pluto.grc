options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Pluto half of the dual capture: covers ch39 (2.480 GHz) at
      4 MSPS direct. Runs as its own process (paired with ble_blade.grc) to
      dodge libusb in-process serialization. Logs to the shared sqlite db.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ble_pluto
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BLE capture (Pluto ch39)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
# -------- Variables --------
- name: db_path
  id: variable
  parameters:
    comment: ''
    value: '"ble_scan.db"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 8]
    rotation: 0
    state: enabled
- name: pluto_samp_rate
  id: variable
  parameters:
    comment: 'low rate — avoids USB contention with bladeRF'
    value: '4000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 56]
    rotation: 0
    state: enabled
- name: pluto_rf_bw
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 56]
    rotation: 0
    state: enabled
- name: pluto_center
  id: variable
  parameters:
    comment: 'ch39 = 2480 MHz'
    value: 2.480e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 56]
    rotation: 0
    state: enabled

# -------- Pluto source (covers ch39) --------
- name: iio_pluto_source_0
  id: soapy_plutosdr_source
  parameters:
    affinity: ''
    alias: ''
    agc: 'False'
    bandwidth: pluto_rf_bw
    center_freq: pluto_center
    comment: 'NOTE: the GRC plutosdr block hardcodes dev=driver=plutosdr (no URI). The runner script (run.sh) sed-patches the generated .py to inject uri=usb:0.3.5. Do not run the .py directly — use run.sh.'
    dev_args: ''
    freq_correction: '0'
    gain: '30.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: pluto_samp_rate
    type: complex
    uri: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 180]
    rotation: 0
    state: enabled
- name: pluto_waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: pluto_samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: 'Pluto (ch39)'
    fc: pluto_center
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: ''
    int_max: '10'
    int_min: '-140'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Pluto ch39"'
    nconnections: '1'
    showports: 'False'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 80]
    rotation: 0
    state: enabled
- name: pluto_ch39_mag2
  id: blocks_complex_to_mag_squared
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 140]
    rotation: 0
    state: enabled
- name: pluto_ch39_keep1n
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: '4 MSPS -> 1 MSPS'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '4'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 140]
    rotation: 0
    state: enabled
- name: pluto_ch39_gfsk
  id: digital_gfsk_demod
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    freq_error: '0.0'
    gain_mu: '0.175'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    mu: '0.5'
    omega_relative_limit: '0.005'
    samples_per_symbol: '4'
    sensitivity: '1.0'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 220]
    rotation: 0
    state: enabled
- name: pluto_ch39_decoder
  id: epy_block
  parameters:
    _source_code: |
      """Shim: thin GRC wrapper around ble_decoder_sqlite.blk."""
      import os, sys
      _HERE = os.path.expanduser('~/Software/rf-parts/simple-plutoble-scanner')
      if _HERE not in sys.path:
          sys.path.insert(0, _HERE)
      from ble_decoder_sqlite import blk as _Parent


      class blk(_Parent):
          def __init__(self, channel_index=39, sdr_name="pluto",
                       db_path="ble_scan.db", invert=False, debug=False):
              _Parent.__init__(self, channel_index=channel_index,
                               sdr_name=sdr_name, db_path=db_path,
                               invert=invert, debug=debug)
    affinity: ''
    alias: ''
    channel_index: '39'
    sdr_name: '"pluto"'
    db_path: db_path
    invert: 'False'
    debug: 'False'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('blk', 'blk', [('channel_index', '39'), ('sdr_name', \"'pluto'\"\
      ), ('db_path', \"'ble_scan.db'\"), ('invert', 'False'), ('debug', 'False')],\
      \ [('0', 'byte', 1), ('1', 'float', 1)], [], 'Shim: thin GRC wrapper around\
      \ ble_decoder_sqlite.blk.', ['channel_index', 'db_path', 'debug', 'invert',\
      \ 'sdr_name'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 180]
    rotation: 0
    state: enabled

connections:
# Pluto ch39 chain (already at 4 MSPS — direct to mag^2 + gfsk)
- [iio_pluto_source_0, '0', pluto_waterfall, '0']
- [iio_pluto_source_0, '0', pluto_ch39_mag2, '0']
- [iio_pluto_source_0, '0', pluto_ch39_gfsk, '0']
- [pluto_ch39_mag2, '0', pluto_ch39_keep1n, '0']
- [pluto_ch39_keep1n, '0', pluto_ch39_decoder, '1']
- [pluto_ch39_gfsk, '0', pluto_ch39_decoder, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
